# Copiar a .env y ajustar
SOCRATA_DOMAIN=www.datos.gov.co
# Recomendado: crea App Token en https://www.datos.gov.co (API -> App Tokens)
# Sin token funciona pero con throttle (~1000 req/hora por IP).
SOCRATA_APP_TOKEN=
SOCRATA_TIMEOUT=40
PAGE_SIZE=1000
DATABASE_URL=postgresql://secop:secop@localhost:5432/secop
API_KEYS=cambia-esta-clave
CACHE_TTL=600
# CACHE_DISABLE=1 para apagar el cache
POSTGRES_USER=secop
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=secop
